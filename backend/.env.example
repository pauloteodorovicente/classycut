# ClassyCut Backend Environment Variables
# Copy to .env and adjust as needed

# Database
# Deixar vazio para usar SQLite automatico em storage/classycut.db (desenvolvimento)
# Para producao (Railway/Render), substituir pela URL do PostgreSQL:
# CLASSYCUT_DATABASE_URL=postgresql://user:password@host:5432/classycut
CLASSYCUT_DATABASE_URL=

# Storage paths (absolute paths recommended for production)
# CLASSYCUT_UPLOAD_DIR=/data/uploads
# CLASSYCUT_PROJECT_DIR=/data/projects
# CLASSYCUT_EXPORT_DIR=/data/exports
# CLASSYCUT_TEMP_DIR=/data/temp

# FFmpeg paths (if not in PATH)
# CLASSYCUT_FFMPEG_PATH=ffmpeg
# CLASSYCUT_FFPROBE_PATH=ffprobe

# Real-ESRGAN binary (optional, for AI upscaling)
# CLASSYCUT_REALESRGAN_PATH=realesrgan-ncnn-vulkan

# Debug mode (set to false in production)
CLASSYCUT_DEBUG=false

# CORS origins (JSON array)
CLASSYCUT_CORS_ORIGINS=["http://localhost:5173"]

# Max upload size in MB
CLASSYCUT_MAX_UPLOAD_SIZE_MB=2048
